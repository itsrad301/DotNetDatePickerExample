@model DateExample.DataModel.LocalDate

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">
                <i class="bi bi-trash"></i> Delete Entry
            </h1>
            <p class="text-muted">Permanently remove this date entry</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger">
                    <h5 class="card-title text-white mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Confirm Deletion
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <strong><i class="bi bi-exclamation-circle"></i> Warning!</strong>
                        <p class="mb-0">This action cannot be undone. Are you sure you want to permanently delete this entry?</p>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>

                    <h5 class="mb-3 mt-4">
                        <i class="bi bi-calendar-event"></i> Entry Details
                    </h5>

                    <dl class="row g-4">
                        <dt class="col-sm-4">
                            <span class="badge bg-primary">
                                <i class="bi bi-calendar-check"></i> @Html.DisplayNameFor(model => model.StartDate)
                            </span>
                        </dt>
                        <dd class="col-sm-8">
                            <span class="h5">
                                @Html.DisplayFor(model => model.StartDate)
                            </span>
                        </dd>

                        <dt class="col-sm-4">
                            <span class="badge bg-success">
                                <i class="bi bi-calendar-event"></i> @Html.DisplayNameFor(model => model.EndDate)
                            </span>
                        </dt>
                        <dd class="col-sm-8">
                            <span class="h5">
                                @Html.DisplayFor(model => model.EndDate)
                            </span>
                        </dd>

                        <dt class="col-sm-4">
                            <span class="badge bg-info">
                                <i class="bi bi-key"></i> Entry ID
                            </span>
                        </dt>
                        <dd class="col-sm-8">
                            <code class="h5">@Model?.ID</code>
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light">
                    <form asp-action="Delete" class="d-flex gap-2">
                        <input type="hidden" asp-for="ID" />
                        <button type="submit" class="btn btn-danger btn-lg flex-grow-1">
                            <i class="bi bi-trash-fill"></i> Delete Entry
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-header bg-secondary">
                    <h5 class="card-title text-white mb-0">
                        <i class="bi bi-info-circle"></i> What Happens Next?
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <span class="badge bg-danger">Step 1</span>
                            <small>Click "Delete Entry" to confirm deletion</small>
                        </li>
                        <li class="mb-2">
                            <span class="badge bg-warning text-dark">Step 2</span>
                            <small>The entry will be permanently removed</small>
                        </li>
                        <li class="mb-2">
                            <span class="badge bg-info">Step 3</span>
                            <small>You will be redirected to the list view</small>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-3 border-danger">
                <div class="card-header bg-danger-subtle border-danger">
                    <h5 class="card-title text-danger mb-0">
                        <i class="bi bi-shield-exclamation"></i> Important
                    </h5>
                </div>
                <div class="card-body text-danger">
                    <p class="small mb-0">
                        <strong>This action is permanent.</strong> Deleted entries cannot be recovered. If unsure, click Cancel to return to the list.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
