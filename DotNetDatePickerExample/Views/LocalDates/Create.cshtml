@model DateExample.DataModel.LocalDate

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Please fix the following errors:</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartDate" class="form-label fw-bold">
                                <i class="bi bi-calendar-check"></i> Start Date
                            </label>
                            <input asp-for="StartDate" class="form-control form-control-lg border-primary" placeholder="Enter start date" />
                            <span asp-validation-for="StartDate" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EndDate" class="form-label fw-bold">
                                <i class="bi bi-calendar-event"></i> End Date
                            </label>
                            <input asp-for="EndDate" class="form-control form-control-lg border-success" placeholder="Enter end date" />
                            <span asp-validation-for="EndDate" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-grid gap-2 d-sm-flex mt-4">
                            <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                                <i class="bi bi-check-circle"></i> Create Entry
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                </form>
                </div>
            </div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
